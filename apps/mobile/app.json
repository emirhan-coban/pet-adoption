{
  "expo": {
    "name": "PawBuddy",
    "slug": "pawbuddy",
    "version": "1.0.0",
    "scheme": "pawbuddy",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f9f9f9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pawbuddy.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f9f9f9"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.pawbuddy.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "PawBuddy fotoğraf galerinize erişmek istiyor.",
          "cameraPermission": "PawBuddy kameranıza erişmek istiyor."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}